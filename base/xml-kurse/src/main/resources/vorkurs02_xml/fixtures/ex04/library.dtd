<!-- DTD externe partagee par tous les fichiers de la bibliotheque -->
<!ELEMENT library (book+)>
<!ELEMENT book (title, author+, year?)>
<!ATTLIST book
          id     ID          #REQUIRED
          lang   (de|fr|en)  "fr"
          status CDATA       #FIXED "active"
          sequel IDREF       #IMPLIED>
<!ELEMENT title  (#PCDATA)>
<!ELEMENT author (#PCDATA)>
<!ELEMENT year   (#PCDATA)>
