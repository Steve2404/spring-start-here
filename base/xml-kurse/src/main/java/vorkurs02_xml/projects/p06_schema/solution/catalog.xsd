<?xml version="1.0" encoding="UTF-8"?>
<!-- Corrige du projet 6 : le schema du catalogue (0.2.14 -> 0.2.15). -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:c="urn:lib:catalog"
           targetNamespace="urn:lib:catalog"
           elementFormDefault="qualified">

  <!-- Le seul element GLOBAL : la seule racine possible d'un document. -->
  <xs:element name="catalog">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="book" type="c:BookType" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Un pattern XSD est toujours ancre sur la valeur entiere : pas de ^ ni de $. -->
  <xs:simpleType name="IsbnType">
    <xs:restriction base="xs:string">
      <xs:pattern value="97[89][0-9]{10}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Une enumeration ferme la liste : "FR" n'est pas "fr". -->
  <xs:simpleType name="LanguageType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="de"/>
      <xs:enumeration value="fr"/>
      <xs:enumeration value="en"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- minExclusive refuse 0 lui-meme ; fractionDigits est un MAXIMUM (19.9 passe, 8.505 non). -->
  <xs:simpleType name="AmountType">
    <xs:restriction base="xs:decimal">
      <xs:minExclusive value="0"/>
      <xs:maxInclusive value="9999.99"/>
      <xs:fractionDigits value="2"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Du texte ET un attribut : un contenu simple qu'on ETEND d'un attribut. -->
  <xs:complexType name="PriceType">
    <xs:simpleContent>
      <xs:extension base="c:AmountType">
        <xs:attribute name="currency" default="EUR">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:pattern value="[A-Z]{3}"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:attribute>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- xs:all : chaque enfant au plus une fois, dans n'importe quel ordre. -->
  <xs:complexType name="MetaType">
    <xs:all>
      <xs:element name="publisher" type="xs:string"/>
      <xs:element name="year" type="xs:gYear" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <!-- Les attributs viennent APRES le modele de contenu. -->
  <xs:complexType name="BookType">
    <xs:sequence>
      <xs:element name="title" type="xs:string"/>
      <xs:element name="author" type="xs:string" maxOccurs="3"/>
      <xs:element name="price" type="c:PriceType"/>
      <xs:element name="meta" type="c:MetaType" minOccurs="0"/>
      <xs:choice>
        <xs:element name="ebookUrl" type="xs:anyURI"/>
        <xs:element name="shelf">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:pattern value="[A-Z][0-9]{2}"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="isbn" type="c:IsbnType" use="required"/>
    <xs:attribute name="lang" type="c:LanguageType" default="fr"/>
    <xs:attribute name="status" type="xs:string" fixed="catalogued"/>
  </xs:complexType>
</xs:schema>
